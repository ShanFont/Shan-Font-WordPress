# Local development. Copy to .env. Do not put production secrets here.
DATABASE_URL=postgresql://sat:sat@127.0.0.1:5432/shan_translation
AUTH_MODE=local
JWT_SECRET=dev-only-change-me
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./var/storage
STORAGE_SIGNING_SECRET=dev-only-change-me
DEV_EXPOSE_TOKENS=true
ADMIN_MFA_REQUIRED=false
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
API_PROXY_TARGET=http://localhost:3001
NEXT_PUBLIC_API_BASE=/api/v1

# Optional seed admin. Leave blank to skip.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Production auth and storage. Leave blank until the real project supplies them.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SENTRY_DSN=

# Transactional email is not bundled. Notifications are recorded as audit intents
# until a provider is configured.
EMAIL_PROVIDER=
